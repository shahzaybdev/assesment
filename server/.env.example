# ──────────────────────────────────────────────
# PostgreSQL connection
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000

# ──────────────────────────────────────────────
# CORS — set to the origin of your frontend
# For local dev with static files, use *
# ──────────────────────────────────────────────
CORS_ORIGIN=*
